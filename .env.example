# ============================================================
#  .env.example  —  SALIN KE .env ISI NYATA (JANGAN DI-COMMIT)
# ============================================================

# ---- Database (TiDB Cloud / MySQL) ----
DB_HOST=your-db-host.example.com
DB_PORT=4000
DB_USER=your_db_user
DB_PASSWORD=REPLACE_WITH_YOUR_REAL_PASSWORD
DB_NAME=your_db_name

# SSL wajib untuk TiDB Cloud (path ke CA cert, atau true untuk verify default)
DB_SSL_CA=
DB_SSL_VERIFY=true

# ---- Session / App ----
SESSION_SECRET=REPLACE_WITH_RANDOM_LONG_SECRET
APP_HOST=127.0.0.1
APP_PORT=8000

# ---- Default login (seed saat pertama jalan) ----
SEED_USERNAME=admin
SEED_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
SEED_FULL_NAME=Administrator

# ---- Scraper defaults ----
SCRAPER_MIN_DELAY=1
SCRAPER_MAX_DELAY=3
SCRAPER_DEFAULT_MAX_RESULTS=100

# ---- Browser Playwright (Chromium) ----
# true  = headless (tidak ada jendela; dipakai bila display stack mati)
# false = headful (default Docker: menggambar di layar virtual Xvfb → noVNC)
BROWSER_HEADLESS=false
# "chrome" = Chrome sistem (lokal/dev) · kosong = Chromium bundled Playwright (Docker)
BROWSER_CHANNEL=

# ---- Monitor Browser / noVNC (hanya dipakai oleh docker/entrypoint.sh) ----
# 1 = aktifkan Xvfb + x11vnc + noVNC (lihat docker-compose.yml port 8002)
NOVNC_ENABLED=1
NOVNC_PORT=8002
# Password akses monitor (maks 8 karakter — batas protokol VNC).
# Kosong = tanpa password: batasi port 8002 lewat firewall/tunnel!
NOVNC_PASSWORD=
# Opsional: URL noVNC absolut bila diakses via HTTPS/Cloudflare tunnel.
NOVNC_PUBLIC_URL=
# Ukuran layar virtual tempat jendela Chromium (3 job bersamaan) dirender
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080

