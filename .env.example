# ============================================================
#  .env.example  —  SALIN KE .env ISI NYATA (JANGAN DI-COMMIT)
# ============================================================

# ---- Database (TiDB Cloud / MySQL) ----
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=VXH7qwuAhDTaE6d.root
DB_PASSWORD=REPLACE_WITH_YOUR_REAL_PASSWORD
DB_NAME=Scraping_data

# SSL wajib untuk TiDB Cloud (path ke CA cert, atau true untuk verify default)
DB_SSL_CA=
DB_SSL_VERIFY=true

# ---- Session / App ----
SESSION_SECRET=REPLACE_WITH_RANDOM_LONG_SECRET
APP_HOST=127.0.0.1
APP_PORT=8000

# ---- Default login (seed saat pertama jalan) ----
SEED_USERNAME=admin
SEED_PASSWORD=agiltampan
SEED_FULL_NAME=Administrator

# ---- Scraper defaults ----
SCRAPER_MIN_DELAY=1
SCRAPER_MAX_DELAY=3
SCRAPER_DEFAULT_MAX_RESULTS=100
